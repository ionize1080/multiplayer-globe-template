{
  "compatibility_date": "2025-04-01",
  "main": "src/server/index.ts",
  "name": "multiplayer-globe-template-preview",
  "migrations": [
    {
      "new_sqlite_classes": [
        "Globe"
      ],
      "tag": "v1"
    }
  ],
  "assets": {
    "directory": "public"
  },
  "build": {
    "command": "node scripts/build.mjs"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Globe",
        "name": "Globe"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "MAIL_DB",
      "database_name": "globe-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
